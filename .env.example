VITE_API_BASE_URL=http://localhost:8000/api/v1
# Positive request timeout in milliseconds.
VITE_API_TIMEOUT_MS=15000
# Session query freshness in milliseconds; does not change cookie lifetime.
VITE_AUTH_STALE_TIME_MS=300000
# Explicit true/false; focus/reconnect still checks cookies when disabled.
VITE_AUTH_SYNC_TABS=true
