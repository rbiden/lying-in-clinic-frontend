VITE_API_BASE_URL=http://localhost:8000/api/v1
# Positive request timeout in milliseconds.
VITE_API_TIMEOUT_MS=15000
# Session query freshness in milliseconds; does not change cookie lifetime.
VITE_AUTH_STALE_TIME_MS=300000
# Explicit true/false; focus/reconnect still checks cookies when disabled.
VITE_AUTH_SYNC_TABS=true

# Public branding values; restart Vite or rebuild after changing them.
VITE_APP_NAME="Lying In Clinic"
# Optional; defaults to VITE_APP_NAME when omitted.
# VITE_APP_SHORT_NAME="Clinic"
VITE_BRAND_WELCOME_TITLE="Hi there!"
VITE_BRAND_LOGIN_DESCRIPTION="Your patients are waiting for you. Sign in to start your day."
VITE_BRAND_ACCESS_HELP="Need access? Contact your clinic administrator."
# Double-quoted \n creates a line break.
VITE_BRAND_TAGLINE="A little care.\nA lasting difference."
VITE_BRAND_DESCRIPTION="Your clinic workspace for patient care, admissions, and the work that keeps each day moving."
# Optional; defaults to VITE_APP_NAME when omitted.
# VITE_BRAND_COPYRIGHT_HOLDER="Clinic owner"
VITE_BRAND_WORKSPACE_LABEL="Workspace"
