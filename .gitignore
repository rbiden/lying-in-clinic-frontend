# Lying In Clinic frontend (React + TypeScript + Vite)

# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
dist-ssr/
*.tsbuildinfo

# Vite and Vitest caches, test coverage
.vite/
.vitest/
coverage/

# Environment files: secrets stay local; .env.example is the shared reference
.env
.env.*
!.env.example
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# AI agent tooling: share skills, agents and project settings; keep personal files local
.claude/settings.local.json
.claude/*.local.*
.codex/*.local.*

# Impeccable design tooling: commit config.json, design.json and live/config.json
.impeccable/config.local.json
.impeccable/hook.cache.json
.impeccable/questions/
.impeccable/mocks/
.impeccable/review/
.impeccable/critique/*
!.impeccable/critique/ignore.md

# Local scratch notes
todos.json

# Editors
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo

# Operating systems
.DS_Store
Thumbs.db
Desktop.ini
